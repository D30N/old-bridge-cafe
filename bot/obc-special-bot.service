[Unit]
Description=Old Bridge Cafe - Today's Special Telegram bot (zero-token poller)
After=network-online.target
Wants=network-online.target

[Service]
Environment="https_proxy=http://hatch-runtime:c9c93bcc76f248fcb7f4f028f59ea5a4@hatch-egress-proxy:3128"
Environment="http_proxy=http://hatch-runtime:c9c93bcc76f248fcb7f4f028f59ea5a4@hatch-egress-proxy:3128"
Environment="HTTPS_PROXY=http://hatch-runtime:c9c93bcc76f248fcb7f4f028f59ea5a4@hatch-egress-proxy:3128"
Environment="HTTP_PROXY=http://hatch-runtime:c9c93bcc76f248fcb7f4f028f59ea5a4@hatch-egress-proxy:3128"
Type=simple
User=root
WorkingDirectory=/home/hatch/workspace/old-bridge-cafe/bot
ExecStart=/usr/bin/python3 /home/hatch/workspace/old-bridge-cafe/bot/special_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
